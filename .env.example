# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the Groq model used for workout generation.
# Primary default is llama-3.3-70b-versatile, with automatic fallback
# to llama-3.1-8b-instant and openai/gpt-oss-120b.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: max requests allowed per IP per minute on /api/workout/generate.
WORKOUT_RATE_LIMIT_PER_MINUTE=10
